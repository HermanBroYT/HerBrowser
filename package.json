{
  "name": "herbrowser",
  "productName": "HerBrowser",
  "version": "1.7.0",
  "description": "HerБраузер для Windows",
  "main": "main.js",
  "author": "HerBrowser",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.herbrowser.desktop",
    "productName": "HerBrowser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "panels.js",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "HerBrowser-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HerBrowser-${version}-portable.${ext}"
    }
  }
}
